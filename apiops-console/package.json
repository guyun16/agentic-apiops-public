{
  "name": "apiops-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "test:context": "node --experimental-strip-types scripts/verify-context-trail.ts",
    "test:console-execution": "node --experimental-strip-types scripts/verify-console-execution.ts",
    "test:diagnosis": "node --experimental-strip-types scripts/verify-diagnosis-history.ts && node --experimental-strip-types scripts/verify-diagnosis-recovery.ts",
    "test:evaluation": "node --experimental-strip-types scripts/verify-evaluation.ts",
    "verify:benchmark": "node --experimental-strip-types scripts/verify-benchmark.ts",
    "preview": "vite preview",
    "test:routes": "node --experimental-strip-types scripts/verify-console-route.ts",
    "test:editor": "node --experimental-strip-types scripts/verify-testcase-editor.ts && node --experimental-strip-types scripts/verify-console-workflows.ts",
    "test:i18n": "node --experimental-strip-types scripts/verify-i18n.ts",
    "test:reports": "node --experimental-strip-types scripts/verify-report-export.ts",
    "typecheck:benchmark": "tsc -p tsconfig.benchmark.json",
    "build:benchmark": "npm run typecheck:benchmark && node scripts/build-benchmark.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  }
}
