JAVA_APIOPS_BASE_URL=http://127.0.0.1:19090
JAVA_APIOPS_TIMEOUT_SECONDS=5.0
JAVA_APIOPS_TOKEN=<java-access-token>
DEEPSEEK_API_KEY=<deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60.0
DIAGNOSIS_LLM_PROVIDER=deepseek
TESTCASE_LLM_PROVIDER=deepseek
QWEN_API_KEY=<qwen-api-key>
QWEN_BASE_URL=https://your-provider.example/v1
