QWEN_TIMEOUT_SECONDS=60.0
MEMORY_DB_PATH=data/historical-memory.sqlite3
RUNTIME_DB_PATH=data/agentlab-runtime.sqlite3
TRACE_SINK=jsonl
TRACE_JSONL_PATH=data/traces/agent-traces.jsonl
TRACE_MAX_FILE_BYTES=16777216
LOG_LEVEL=INFO
ENVIRONMENT=development
