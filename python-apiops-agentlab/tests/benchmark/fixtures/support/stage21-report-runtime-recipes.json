      "recipeKind": "BUSINESS_INVENTORY_CONFLICT",
      "readbackDeadlineSeconds": 60,
      "testCase": {
        "schemaVersion": "1.0.0",
        "caseId": "stage21_failure_business_inventory",
        "projectId": 1001,
        "apiId": "api_create_order",
        "name": "Stage 21 insufficient inventory report recipe",
        "environment": {
          "baseUrl": "http://localhost:8080",
          "variables": {}
        },
        "tags": ["stage21", "runtime-recipe", "business-conflict"],
        "steps": [
          {
            "stepId": "stage21-insufficient-inventory",
            "name": "Create an order exceeding available inventory",
            "request": {
              "method": "POST",
              "path": "/orders",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "userId": 1,
                "items": [
                  {
                    "productId": 2,
                    "quantity": 3
                  }
                ]
              }
            },
            "assertions": [
              {
                "type": "STATUS_CODE",
                "expected": 409
              },
              {
                "type": "HEADER",
                "name": "Content-Type",
                "operator": "EQUALS",
                "expected": "application/json"
              },
              {
                "type": "JSON_PATH",
                "expression": "$.code",
                "operator": "EQUALS",
                "expected": "ORDER_BUSINESS_CONFLICT"
              },
              {
                "type": "JSON_PATH",
                "expression": "$.data",
                "operator": "EXISTS"
              },
              {
                "type": "RESPONSE_TIME",
                "maxMs": 1000
              }
            ],
            "extractors": []
          }
        ]
      }
    },
