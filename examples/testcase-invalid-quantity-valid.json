            "name": "Submit create order request with quantity 0",
            "request": {
                "method": "POST",
                "path": "/api/orders",
                "query": {},
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer {{token}}"
                },
                "body": {
                    "productId": "prod_001",
                    "quantity": 0
                }
