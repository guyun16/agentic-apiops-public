# Agentic APIOps Java Platform local environment template.
# Copy to .env and keep the copy untracked. Docker Compose reads .env;
# import it into the Java process as described in docs/README-dev-env.md.

# -----------------------------------------------------------------------------
# Non-secret local database configuration
# The dev Compose MySQL service initializes all six schemas with an empty local
# root password. Set matching passwords here only if you deliberately secure
# the local MySQL service and export the same values to the Java process.
# -----------------------------------------------------------------------------
APIOPS_AUTH_DB_URL=jdbc:mysql://127.0.0.1:3306/apiops_auth
APIOPS_AUTH_DB_USERNAME=root
APIOPS_AUTH_DB_PASSWORD=
APIOPS_OPENAPI_DB_URL=jdbc:mysql://127.0.0.1:3306/apiops_openapi
APIOPS_OPENAPI_DB_USERNAME=root
APIOPS_OPENAPI_DB_PASSWORD=
APIOPS_RUNNER_DB_URL=jdbc:mysql://127.0.0.1:3306/apiops_runner
APIOPS_RUNNER_DB_USERNAME=root
APIOPS_RUNNER_DB_PASSWORD=
APIOPS_TOOL_GATEWAY_DB_URL=jdbc:mysql://127.0.0.1:3306/apiops_tool_gateway
APIOPS_TOOL_GATEWAY_DB_USERNAME=root
APIOPS_TOOL_GATEWAY_DB_PASSWORD=
APIOPS_RAG_DB_URL=jdbc:mysql://127.0.0.1:3306/apiops_rag
APIOPS_RAG_DB_USERNAME=root
APIOPS_RAG_DB_PASSWORD=
APIOPS_ORDER_DB_URL=jdbc:mysql://127.0.0.1:3306/apiops_demo_order
APIOPS_ORDER_DB_USERNAME=root
APIOPS_ORDER_DB_PASSWORD=

# Docker host published ports for the long-lived development Compose project.
# These are host-side bindings only; Java application connection ports remain
# APIOPS_REDIS_PORT and APIOPS_RABBITMQ_PORT below.
APIOPS_DEV_MYSQL_PORT=3306
APIOPS_DEV_REDIS_PORT=6379
APIOPS_DEV_RABBITMQ_PORT=5672
APIOPS_DEV_RABBITMQ_MANAGEMENT_PORT=15672

# Local application identity and core infrastructure.
APIOPS_JWT_SECRET=replace-with-a-random-local-only-secret
APIOPS_REDIS_HOST=127.0.0.1
APIOPS_REDIS_PORT=6379
APIOPS_REDIS_PASSWORD=
APIOPS_REDIS_TIMEOUT=2s
APIOPS_REDIS_HEALTH_ENABLED=true
APIOPS_RABBITMQ_HOST=127.0.0.1
APIOPS_RABBITMQ_PORT=5672
APIOPS_RABBITMQ_USERNAME=guest
APIOPS_RABBITMQ_PASSWORD=guest
APIOPS_RABBITMQ_EXECUTION_ENABLED=true
APIOPS_RABBITMQ_EXECUTION_EXCHANGE=apiops.execution.exchange
APIOPS_RABBITMQ_EXECUTION_ROUTING_KEY=apiops.execution.run
APIOPS_RABBITMQ_EXECUTION_QUEUE=apiops.execution.queue
APIOPS_RABBITMQ_EXECUTION_DLX=apiops.execution.dlx
APIOPS_RABBITMQ_EXECUTION_DLQ_ROUTING_KEY=apiops.execution.dead
APIOPS_RABBITMQ_EXECUTION_DLQ=apiops.execution.dlq
APIOPS_RABBITMQ_EXECUTION_MAX_ATTEMPTS=3
APIOPS_RUNNER_PROGRESS_ENABLED=true
APIOPS_RUNNER_PROGRESS_TTL=24h
APIOPS_RUNNER_PROGRESS_SSE_TIMEOUT=30m
APIOPS_RUNNER_EXECUTOR_CORE_POOL_SIZE=2
APIOPS_RUNNER_EXECUTOR_MAXIMUM_POOL_SIZE=4
APIOPS_RUNNER_EXECUTOR_KEEP_ALIVE_TIME=30s
APIOPS_RUNNER_EXECUTOR_QUEUE_CAPACITY=32
APIOPS_RUNNER_EXECUTOR_THREAD_NAME_PREFIX=apiops-runner-
# Keep below Python JAVA_APIOPS_TIMEOUT_SECONDS (5s by default).
APIOPS_TOOL_GATEWAY_EXECUTION_TIMEOUT=4s

# -----------------------------------------------------------------------------
# Optional RAG / real external configuration. Keep real credentials empty in
# this template. These values do not activate real Maven tests by themselves.
# -----------------------------------------------------------------------------
APIOPS_RAG_CHUNK_SIZE=1000
APIOPS_RAG_CHUNK_OVERLAP=100
APIOPS_RAG_QDRANT_ENABLED=false
APIOPS_RAG_QDRANT_BASE_URL=http://127.0.0.1:6333
APIOPS_RAG_QDRANT_COLLECTION=apiops_rag_chunks_v1
APIOPS_RAG_QDRANT_TIMEOUT=10s
APIOPS_RAG_QDRANT_API_KEY=
ZHIPU_API_KEY=
ZHIPU_EMBEDDING_TIMEOUT=30s
DEEPSEEK_API_KEY=
APIOPS_STAGE9_REAL_E2E=false

# Optional demo-order HTTP integration / external E2E configuration.
APIOPS_HTTP_DEMO_ORDER_IT=false
APIOPS_DEMO_ORDER_BASE_URL=http://127.0.0.1:18080
APIOPS_DEMO_ORDER_E2E=false
APIOPS_DEMO_ORDER_FAULT_BASE_URL=http://127.0.0.1:18081

# Stage 20 final deterministic E2E. The Java test harness supplies the runtime
# JWT, random Java base URL, project/api IDs, and trace ID to Python in-memory.
# Do not place those runtime values in this file.
STAGE20_RUNNER_READBACK_DEADLINE_SECONDS=60
REAL_MODEL_E2E=false

# Optional local observability overlay. Fill the password before starting
# Grafana; never commit the filled .env file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Optional JMeter runtime inputs. Keep tokens and passwords empty here; inject
# them only for a deliberate local performance run.
APIOPS_PERF_ACCESS_TOKEN=
APIOPS_PERF_USERNAME=
APIOPS_PERF_PASSWORD=
APIOPS_PERF_DB_PASSWORD=
# Optional local benchmark order API key (Authorization header).
# Empty means /stage21/auth-check denies all requests; /orders is unchanged.
APIOPS_BENCHMARK_ORDER_API_KEY=
